{
  "name": "fantasy12-api",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "dev:worker": "ts-node-dev --respawn --transpile-only src/worker.ts",
    "build": "tsc",
    "ci:check": "node scripts/run-security-gates.js",
    "security:audit": "npm audit --omit=dev --audit-level=high",
    "docker:build": "docker build -t fantasy12-api:local .",
    "test:ranking": "npm run build && node --test tests/ranking-window-score.test.js",
    "test:payments": "npm run build && node --test tests/mercado-pago-*.test.js tests/subscription-access.test.js",
    "test:benefits": "npm run build && node --test tests/benefit-consumption.test.js tests/regrant-open-round-benefits.test.js",
    "test:worker": "npm run build && node --test tests/bullmq-*.test.js",
    "test:teams": "node --test tests/team-seed.test.js tests/team-route-permissions.test.js",
    "test:preferences": "npm run build && node --test tests/user-preferences.test.js",
    "test:security": "npm run build && node --test tests/csrf-protection.test.js tests/session-security.test.js tests/wallet-atomicity.test.js tests/security-rbac.test.js tests/security-identity-validation.test.js tests/privacy-security.test.js tests/security-route-policy.test.js tests/security-platform-controls.test.js tests/migration-baseline-v2.test.js tests/container-hardening.test.js tests/logger-secret-redaction.test.js",
    "test:competition": "npm run build && node --test tests/ranking-tiebreak.test.js tests/ranking-secondary-tiebreak.test.js tests/ranking-window-score.test.js tests/scoring-ranking-integration.test.js tests/period-ranking.test.js tests/bolao-registration-rules.test.js tests/bolao-financial-rules.test.js tests/bolao-prize-allocation.test.js tests/bolao-invite-security.test.js tests/close-expired-bolao.test.js tests/monthly-ranking-cohort.test.js tests/mesa-prize-rules.test.js tests/mesa-financial-migration.test.js tests/official-rule-integrity.test.js tests/ticket-normalization.test.js",
    "test:invite:postgres": "npm run build && node scripts/test-bolao-invite-concurrency.js",
    "start": "node dist/index.js",
    "start:worker": "node dist/worker.js",
    "prisma:generate": "npx prisma generate",
    "prisma:migrate:status": "npx prisma migrate status",
    "prisma:migrate:deploy": "npx prisma migrate deploy",
    "prisma:migrate:baseline:cutover": "node scripts/rebaseline-migration-history.js",
    "prisma:migrate:audit:chain": "node scripts/audit-migration-chain.js",
    "prisma:migrate:audit:chain:report": "node scripts/audit-migration-chain.js --report-only",
    "prisma:migrate:audit:chain:baseline": "node scripts/audit-migration-chain.js --baseline-check",
    "prisma:db:push": "npx prisma db push",
    "prisma:baseline:fresh:generate": "mkdir -p prisma/baselines && npx prisma migrate diff --from-empty --to-schema-datamodel prisma/schema.prisma --script > prisma/baselines/current-fresh-schema.sql",
    "prisma:baseline:fresh:verify": "node scripts/verify-fresh-baseline.js",
    "prisma:migration:policy:check": "node scripts/check-migration-policy.js",
    "prisma:schema:release:check": "npm run prisma:migrate:audit:chain:baseline && npm run prisma:baseline:fresh:verify && npm run prisma:migration:policy:check && npm run product:rules:check && npm run build",
    "product:rules:check": "node scripts/check-product-rule-policy.js",
    "prisma:bootstrap:fresh": "npm run build && node scripts/bootstrap-database.js",
    "prisma:bootstrap:fresh:skip-seed": "npm run build && node scripts/bootstrap-database.js --skip-seed",
    "seed:admin-permissions": "node prisma/seed-admin-permissions.js",
    "seed:app": "node prisma/seed.js",
    "seed:teams": "node prisma/seed-teams.js",
    "seed:teams:dry-run": "node prisma/seed-teams.js --dry-run",
    "seed:test-data": "node prisma/seed-test-data.js",
    "ranking:monthly:backfill": "npm run build && node scripts/backfill-monthly-ranking-state.js",
    "score:recompute-scored-rounds": "npm run build && node scripts/recompute-scored-rounds.js",
    "simulate:competition": "npm run build && node scripts/simulate-competition.js",
    "simulate:six-month-competition": "npm run build && node scripts/simulate-six-month-competition.js",
    "simulate:mesa-score-validation": "npm run build && node scripts/validate-mesa-score-scenario.js",
    "benefits:regrant-open-round": "node scripts/regrant-open-round-benefits.js",
    "db:backup": "node scripts/backup-postgres.js",
    "db:backup:verify": "node scripts/verify-postgres-backup.js",
    "db:restore": "node scripts/restore-postgres.js",
    "mesa:integrity:diagnose": "npm run build && node scripts/diagnose-mesa-integrity.js",
    "mesa:scores:repair:dry": "npm run build && node scripts/repair-closed-bolao-scores.js",
    "mesa:scores:repair:apply": "npm run build && node scripts/repair-closed-bolao-scores.js --apply"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "overrides": {
    "brace-expansion": "1.1.18",
    "follow-redirects": "1.16.0",
    "form-data": "4.0.6",
    "path-to-regexp": "0.1.13",
    "picomatch": "2.3.2"
  },
  "dependencies": {
    "@prisma/client": "^5.11.0",
    "axios": "^1.18.1",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.80.2",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "express-rate-limit": "^8.6.0",
    "express-session": "^1.19.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.11.1",
    "nodemailer": "^9.0.3",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "prisma": "^5.22.0",
    "zod": "^4.3.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.2",
    "@types/helmet": "^0.0.48",
    "@types/node": "^20.11.30",
    "@types/nodemailer": "^8.0.0",
    "pino-pretty": "^13.1.3",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  }
}
